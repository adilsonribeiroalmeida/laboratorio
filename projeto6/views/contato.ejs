<%- include('partials/header') %>

<section class="bg-warning py-5 text-white text-center dados">
  <div class="container d-lg-flex column-gap-3">
    <div>
      <i class="fa-solid fa-location-dot fs-1"></i>
      <span class="d-block mt-2 fs-5">
        Rua Belo Horizonte 123, Centro
        <br />
        Sales - SP
      </span>
    </div>
    <div class="mt-5 mt-lg-0">
      <i class="fa-solid fa-envelope fs-1"></i>
      <span class="d-block mt-2 fs-5">contato@empresaxpto.com.br</span>
    </div>
    <div class="mt-5 mt-lg-0">
      <i class="fa-solid fa-mobile fs-1"></i>
      <span class="d-block mt-2 fs-5">0800-123-4567</span>
    </div>
  </div>
</section>
<section class="position-relative mapa">
  <div class="info bg-success text-white p-3 d-flex align-items-center">
    Rua Belo Horizonte 123, Centro - Sales / SP
    <br />
    contato@empresaxpto.com.br
    <br />
    0800-123-4567
  </div>
  <iframe
    class="w-100"
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2085.6701875859494!2d-49.4978652940358!3d-21.341024546870866!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94be786871b3ee47%3A0x5d8c8587b971d203!2sAv.%20Tirso%20Martins%2C%2077%2C%20Sales%20-%20SP%2C%2014980-000!5e0!3m2!1spt-BR!2sbr!4v1777673993032!5m2!1spt-BR!2sbr"
    height="450"
    style="border: 0"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</section>

<section class="py-5 fale-conosco">
  <div class="container py-5">
    <h2 class="text-center text-uppercase fs-1 fw-light mb-5">Fale conosco</h2>
    <form method="post" id="formulario-contato">
      <input
        type="text"
        placeholder="Nome"
        class="form-control d-block w-100 mb-1 form-control-lg"
        name="nome"
        id="nome"
        required
      />
      <input
        type="email"
        placeholder="Email"
        class="form-control d-block w-100 mb-1 form-control-lg"
        name="email"
        id="email"
        required
      />
      <input
        type="number"
        placeholder="Telefone"
        class="form-control d-block w-100 mb-1 form-control-lg"
        name="telefone"
        id="telefone"
        required
      />
      <input
        type="text"
        placeholder="Mensagem"
        class="form-control d-block w-100 mb-1 form-control-lg"
        name="mensagem"
        id="mensagem"
        required
      />
      <button class="btn btn-success d-block w-100 btn-lg" type="submit">
        Enviar
      </button>
    </form>
  </div>
</section>
<script src="./js/contato.js"></script>
<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="bg-light blog">
  <div class="container py-5">
    <h2 class="text-center text-uppercase fs-1 fw-light mb-5">Blog</h2>
    <div class="d-lg-flex column-gap-3">
      <% artigos.forEach((artigo)=>{ %>
       <div>
            <div
              class="ratio-4x3 capa"
              style="background-image: url('/img/<%= artigo.imagem %>')"
            ></div>
            <h3 class="mt-3 fs-2 fw-normal mb-1">
              <%= artigo.titulo %>
            </h3>
            <p class="mb-1">
             <%= artigo.resumo %>
            </p>
            <a
              href="/blog/<%= artigo.slug %>"
              class="text-decoration-none text-warning"
              >Leia mais</a
            >
          </div>
          <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

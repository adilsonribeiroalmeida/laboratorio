<%- include('partials/header') %>
<section class="py-5">
  <h2 class="text-center mb-5 text-uppercase fw-light fs-1">
    <%= servico.nome %>
  </h2>
  <div class="container d-lg-flex column-gap-3">
    <div class="w-lg-50">
      <img
        class="img-fluid"
        src="/img/<%= servico.imagem %>"
        alt="<%= servico.nome %>"
      />
    </div>
    <div class="w-lg-50">
      <p>
       <%= servico.descricao %>
      </p>
      <div class="d-flex mt-3 align-items-center column-gap-2">
        <div style="width: 35px">
          <i class="fa-regular fa-clock fs-2 text-warning"></i>
        </div>
        <div style="line-height: 25px">
          Tempo de execução
          <br />
          <%= servico.tempoExecucao.slice(0,5) %> horas
        </div>
      </div>
      <div class="d-flex mt-3 align-items-center column-gap-2">
        <div style="width: 35px">
          <i class="fa-regular fa-calendar-days fs-2 text-warning"></i>
        </div>
        <div style="line-height: 25px">
          Validade
          <br />
          <%= servico.validade %>
        </div>
      </div>
      <div class="d-flex mt-3 align-items-center column-gap-2">
        <div style="width: 35px">
          <i class="fa-solid fa-dollar-sign fs-2 text-warning"></i>
        </div>
        <div style="line-height: 25px">
          Valor
          <br />
          <%= servico.preco.replace('.',',') %>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
